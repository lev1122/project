def create_transparent_text(text, font, color, alpha):
    """Создает полупрозрачный текст"""
    text_surface = font.render(text, True, color)
    alpha_surface = pygame.Surface(text_surface.get_size(), pygame.SRCALPHA)
    alpha_surface.fill((255, 255, 255, alpha))
    text_surface.set_alpha(alpha)
    return text_surface


def main():
    clock = pygame.time.Clock()

    # Создаем блюда у нижнего края экрана
    dishes = [
        DraggableDish(150, HEIGHT - 100, draw_pizza_side, "Пицца"),
        DraggableDish(300, HEIGHT - 100, draw_soup_side, "Суп"),
        DraggableDish(450, HEIGHT - 100, draw_salad_side, "Салат"),
        DraggableDish(600, HEIGHT - 100, draw_chicken_side, "Курица")
    ]

    dragging_dish = None

    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            elif event.type == pygame.MOUSEBUTTONDOWN:
                if event.button == 1:  # Левая кнопка мыши
                    for dish in dishes:
                        if dish.is_clicked(event.pos):
                            dragging_dish = dish
                            dish.start_drag(event.pos)
                            # Поднимаем блюдо наверх в списке для отрисовки
                            dishes.remove(dish)
                            dishes.append(dish)
                            break

            elif event.type == pygame.MOUSEBUTTONUP:
                if event.button == 1 and dragging_dish:
                    dragging_dish.stop_drag()
                    dragging_dish = None

            elif event.type == pygame.MOUSEMOTION:
                if dragging_dish:
                    dragging_dish.update_position(event.pos)

        # Отрисовка
        screen.fill(BACKGROUND)

        # Рисуем все блюда
        for dish in dishes:
            dish.draw(screen)

        pygame.display.flip()
        clock.tick(60)

if __name__ == "__main__":
    main()
