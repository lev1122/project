import pygame
import sys
import math

pygame.init()

WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("4 Вида Блюд - Перетаскивание")

WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
BROWN = (139, 69, 19)
GOLDEN = (218, 165, 32)
RED = (255, 0, 0)
GREEN = (0, 128, 0)
YELLOW = (255, 255, 0)
ORANGE = (255, 165, 0)
CREAM = (255, 253, 208)
PLATE_COLOR = (200, 200, 200)
SOUP_COLOR = (210, 180, 140)
DARK_BROWN = (101, 67, 33)
CHICKEN_COLOR = (210, 180, 140)
CRISPY_COLOR = (220, 170, 100)
BACKGROUND = (245, 240, 230)


class DraggableDish:
    def __init__(self, x, y, draw_function, name):
        self.x = x
        self.y = y
        self.draw_function = draw_function
        self.name = name
        self.dragging = False
        self.offset_x = 0
        self.offset_y = 0
        self.width = 160
        self.height = 100

    def draw(self, surface):
        self.draw_function(self.x, self.y)

        # Рисуем рамку при перетаскивании
        if self.dragging:
            pygame.draw.rect(surface, (255, 0, 0),
                             (self.x - self.width // 2, self.y - self.height // 2,
                              self.width, self.height), 2)

    def is_clicked(self, pos):
        x, y = pos
        return (self.x - self.width // 2 <= x <= self.x + self.width // 2 and
                self.y - self.height // 2 <= y <= self.y + self.height // 2)

    def start_drag(self, pos):
        self.dragging = True
        self.offset_x = self.x - pos[0]
        self.offset_y = self.y - pos[1]

    def stop_drag(self):
        self.dragging = False

    def update_position(self, pos):
        if self.dragging:
            self.x = pos[0] + self.offset_x
            self.y = pos[1] + self.offset_y

            # Ограничиваем перемещение в пределах экрана
            self.x = max(self.width // 2, min(WIDTH - self.width // 2, self.x))
            self.y = max(self.height // 2, min(HEIGHT - self.height // 2, self.y))


def draw_pizza_side(x, y):
    # Тарелка
    pygame.draw.ellipse(screen, (180, 180, 200), (x - 85, y, 170, 22))
    pygame.draw.ellipse(screen, (230, 230, 250), (x - 80, y + 2, 160, 18))
    pygame.draw.ellipse(screen, WHITE, (x - 75, y + 4, 150, 14))

    # Основа пиццы 
    pygame.draw.ellipse(screen, (200, 150, 80), (x - 75, y - 18, 150, 35))

    # Верх пиццы
    pygame.draw.ellipse(screen, (220, 180, 100), (x - 75, y - 25, 150, 12))

    # корочка
    for i in range(-7, 8):
        crust_x = x + i * 10
        if abs(i) >= 5:  # по краям
            pygame.draw.ellipse(screen, (180, 120, 60), (crust_x - 4, y - 22, 8, 8))

    # Сыр
    for i in range(-5, 6):
        cheese_x = x + i * 14
        cheese_y = y - 15 + math.sin(i) * 2
        pygame.draw.ellipse(screen, (255, 220, 100), (cheese_x - 6, cheese_y - 3, 12, 8))

    # Пепперони 
    for i in range(-4, 5):
        if i % 2 == 0:
            pep_x = x + i * 18
            pep_y = y - 12 + math.cos(i) * 3
            pygame.draw.ellipse(screen, (200, 40, 40), (pep_x - 5, pep_y - 2, 10, 6))
            pygame.draw.ellipse(screen, (255, 100, 100), (pep_x - 3, pep_y - 3, 4, 3))

    # Зелень - базилик
    for i in range(-3, 4):
        if i != 0:
            herb_x = x + i * 20
            herb_y = y - 20
            pygame.draw.ellipse(screen, (60, 180, 60), (herb_x - 2, herb_y, 4, 6))

