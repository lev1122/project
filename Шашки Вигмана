def start_auth_flow(start_root):
    #Запуск процесса авторизации
    start_root.destroy()
    show_auth_window(1, None)


def show_auth_window(player_num, player1_name=None):
    #Окно авторизации
    root = tk.Tk()
    root.title(f"Авторизация - Игрок {player_num}")
    center_window(root, 400, 350)
    root.protocol("WM_DELETE_WINDOW", lambda: on_closing(root))

    tk.Label(root, text=f"Вход - Игрок {player_num}", font=("Arial", 20, "bold")).pack(pady=20)

    tk.Label(root, text="Логин:", font=("Arial", 12)).pack(pady=5)
    login_entry = tk.Entry(root, font=("Arial", 12), width=25)
    login_entry.pack(pady=5)

    tk.Label(root, text="Пароль:", font=("Arial", 12)).pack(pady=5)
    password_entry = tk.Entry(root, font=("Arial", 12), width=25, show="*")
    password_entry.pack(pady=5)

    btn_frame = tk.Frame(root)
    btn_frame.pack(pady=20)

    def do_login():
        login = login_entry.get().strip()
        password = password_entry.get()

        if not validate_credentials(login, password):
            return

        if verify_user(login, password):
            if player_num == 1:
                messagebox.showinfo("Успех", f"Игрок 1 (белые): {login}\n\nТеперь авторизуйтесь как Игрок 2")
                root.destroy()
                show_auth_window(2, login)
            else:
                if player1_name == login:
                    messagebox.showwarning("Внимание", "Оба игрока используют один логин!")
                messagebox.showinfo("Успех", f"Игрок 2 (чёрные): {login}\n\nИгра начинается!")
                root.destroy()
                game_root = tk.Tk()
                GameBoard(game_root, [player1_name, login])
                game_root.mainloop()
        else:
            messagebox.showerror("Ошибка", "Неверный логин или пароль!")

    def show_reg():
        root.destroy()
        show_register_window(player_num, player1_name)

    def go_back():
        root.destroy()
        if player_num == 1:
            show_start_window()
        else:
            show_auth_window(1, None)

    tk.Button(btn_frame, text="Войти", font=("Arial", 12), width=12,
              command=do_login).pack(side="left", padx=5)
    tk.Button(btn_frame, text="Регистрация", font=("Arial", 12), width=12,
              command=show_reg).pack(side="left", padx=5)

    tk.Button(root, text="Назад", font=("Arial", 10),
              command=go_back).pack(pady=10)

    root.mainloop()


def show_register_window(player_num, player1_name=None):
    #Окно регистрации
    root = tk.Tk()
    root.title("Регистрация")
    center_window(root, 400, 400)
    root.protocol("WM_DELETE_WINDOW", lambda: on_closing(root))

    tk.Label(root, text="Регистрация", font=("Arial", 20, "bold")).pack(pady=20)

    tk.Label(root, text="Логин:", font=("Arial", 12)).pack(pady=5)
    login_entry = tk.Entry(root, font=("Arial", 12), width=25)
    login_entry.pack(pady=5)

    tk.Label(root, text="Пароль:", font=("Arial", 12)).pack(pady=5)
    password_entry = tk.Entry(root, font=("Arial", 12), width=25, show="*")
    password_entry.pack(pady=5)

    tk.Label(root, text="Подтвердите пароль:", font=("Arial", 12)).pack(pady=5)
    confirm_entry = tk.Entry(root, font=("Arial", 12), width=25, show="*")
    confirm_entry.pack(pady=5)

    def do_register():
        login = login_entry.get().strip()
        password = password_entry.get()
        confirm = confirm_entry.get()

        if not validate_credentials(login, password):
            return

        if password != confirm:
            messagebox.showerror("Ошибка", "Пароли не совпадают!")
            return

        if user_exists(login):
            messagebox.showerror("Ошибка", "Пользователь с таким логином уже существует!")
            return

        password_hash = encrypt_password(password)
        if save_user(login, password_hash):
            messagebox.showinfo("Успех", "Регистрация прошла успешно!")
            root.destroy()
            show_auth_window(player_num, player1_name)
        else:
            messagebox.showerror("Ошибка", "Не удалось сохранить пользователя!")

    def go_back():
        root.destroy()
        show_auth_window(player_num, player1_name)

    tk.Button(root, text="Зарегистрироваться", font=("Arial", 12), width=18,
              command=do_register).pack(pady=20)

    tk.Button(root, text="Назад к авторизации", font=("Arial", 10),
              command=go_back).pack(pady=10)

    root.mainloop()

def center_window(window, width, height):
    #Центрирование окна
    screen_width = window.winfo_screenwidth()
    screen_height = window.winfo_screenheight()
    x = (screen_width // 2) - (width // 2)
    y = (screen_height // 2) - (height // 2)
    window.geometry(f"{width}x{height}+{x}+{y}")

def on_closing(root):
    #Закрытие программы
    try:
        root.quit()
        root.destroy()
    except:
        pass
    import sys
    sys.exit(0)

if __name__ == '__main__':
    show_start_window()
