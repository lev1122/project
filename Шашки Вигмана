import tkinter as tk
from tkinter import messagebox
import hashlib
import os

BOARD_SIZE = 8
CELL_SIZE = 80
MARGIN = 30
WINDOW_WIDTH = 8 * CELL_SIZE + 2 * MARGIN + 40
WINDOW_HEIGHT = 8 * CELL_SIZE + 2 * MARGIN + 180

EMPTY = 0
WHITE = 1
BLACK = 2
WHITE_KING = 3
BLACK_KING = 4

USER_DB_FILE = "users.txt"


def encrypt_password(password):
    return hashlib.sha256(password.encode()).hexdigest()

def decrypt_password(encrypted):
    return encrypted


def load_users():
    if not os.path.exists(USER_DB_FILE):
        return {}
    users = {}
    try:
        with open(USER_DB_FILE, 'r', encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if line and ':' in line:
                    login, password_hash = line.split(':', 1)
                    users[login] = password_hash
    except Exception as e:
        print(f"Ошибка загрузки базы данных: {e}")
    return users


def save_user(login, password_hash):
    try:
        with open(USER_DB_FILE, 'a', encoding='utf-8') as f:
            f.write(f"{login}:{password_hash}\n")
        return True
    except Exception as e:
        print(f"Ошибка сохранения пользователя: {e}")
        return False

def user_exists(login):
    users = load_users()
    return login in users

def verify_user(login, password):
    users = load_users()
    if login not in users:
        return False
    password_hash = encrypt_password(password)
    return users[login] == password_hash

def validate_credentials(login, password):
    if len(login) < 2:
        messagebox.showerror("Ошибка", "Логин должен содержать минимум 2 символа!")
        return False
    if len(password) < 2:
        messagebox.showerror("Ошибка", "Пароль должен содержать минимум 2 символа!")
        return False
    if not login.strip():
        messagebox.showerror("Ошибка", "Логин не может быть пустым!")
        return False
    if not password.strip():
        messagebox.showerror("Ошибка", "Пароль не может быть пустым!")
        return False
    return True


class GameEngine:

    def __init__(self):
        self.board = [[EMPTY for _ in range(BOARD_SIZE)] for _ in range(BOARD_SIZE)]
        self.turn = WHITE
        self.half_moves = 0
        self.must_capture_second = False
        self.first_move_pos = None
        self.init_board()

    def init_board(self):
        #Инициализация начальной позиции
        for y in range(BOARD_SIZE):
            for x in range(BOARD_SIZE):
                if (x + y) % 2 == 0:
                    if y < 3:
                        self.board[y][x] = BLACK
                    elif y > 4:
                        self.board[y][x] = WHITE
                else:
                    if y < 3:
                        self.board[y][x] = BLACK
                    elif y > 4:
                        self.board[y][x] = WHITE

    def is_move_valid(self, x, y):
        #Алгоритм проверки доступности хода
        if not (0 <= x < 8 and 0 <= y < 8):
            return False
        if self.board[y][x] != EMPTY:
            return False
        return True

    def get_moves(self, x, y):
        #Алгоритм проверки возможности хода
        piece = self.board[y][x]

        if self.must_capture_second:
            return self.get_captures(x, y, piece)

        captures = self.get_captures(x, y, piece)
        moves = []
        if piece in (WHITE, BLACK):
            directions = [(-1, -1), (1, -1)] if piece == WHITE else [(-1, 1), (1, 1)]
            for dx, dy in directions:
                nx, ny = x + dx, y + dy
                if self.is_move_valid(nx, ny):
                    moves.append((nx, ny))
        else:
            for dx, dy in [(-1, -1), (1, -1), (-1, 1), (1, 1)]:
                nx, ny = x + dx, y + dy
                while self.is_move_valid(nx, ny):
                    moves.append((nx, ny))
                    nx += dx
                    ny += dy

        return captures + moves

    def get_captures(self, x, y, piece):
        #Получение возможных взятий
        captures = []
        enemy = (BLACK, BLACK_KING) if piece in (WHITE, WHITE_KING) else (WHITE, WHITE_KING)
        if piece in (WHITE, BLACK):
            for dx, dy in [(-1, -1), (1, -1), (-1, 1), (1, 1)]:
                nx, ny = x + dx, y + dy
                jx, jy = x + 2 * dx, y + 2 * dy
                if 0 <= nx < 8 and 0 <= ny < 8 and 0 <= jx < 8 and 0 <= jy < 8:
                    if self.board[ny][nx] in enemy and self.board[jy][jx] == EMPTY:
                        captures.append((jx, jy))
        else:
            for dx, dy in [(-1, -1), (1, -1), (-1, 1), (1, 1)]:
                nx, ny = x + dx, y + dy
                while 0 <= nx < 8 and 0 <= ny < 8:
                    if self.board[ny][nx] == EMPTY:
                        nx += dx
                        ny += dy
                        continue
                    if self.board[ny][nx] in enemy:
                        jx, jy = nx + dx, ny + dy
                        while 0 <= jx < 8 and 0 <= jy < 8 and self.board[jy][jx] == EMPTY:
                            captures.append((jx, jy))
                            jx += dx
                            jy += dy
                        break
                    else:
                        break
        return captures

    def check_threat_created(self, move_to_pos):
        #Алгоритм проверки создания угрозы
        x, y = move_to_pos
        piece = self.board[y][x]
        captures = self.get_captures(x, y, piece)
        return len(captures) > 0

    def make_move(self, src, dst):
        #Выполнение хода
        sx, sy = src
        dx, dy = dst
        piece = self.board[sy][sx]

        dx_dir = 1 if dx > sx else -1
        dy_dir = 1 if dy > sy else -1

        if piece in (WHITE_KING, BLACK_KING):
            x, y = sx + dx_dir, sy + dy_dir
            while (x, y) != (dx, dy):
                if self.board[y][x] in (WHITE, BLACK, WHITE_KING, BLACK_KING) and self.board[y][x] != piece:
                    self.board[y][x] = EMPTY
                    break
                x += dx_dir
                y += dy_dir
        else:
            if abs(dx - sx) == 2:
                mx, my = (sx + dx) // 2, (sy + dy) // 2
                self.board[my][mx] = EMPTY

        self.board[dy][dx] = piece
        self.board[sy][sx] = EMPTY
        self.promote(dx, dy)

    def promote(self, x, y):
        #Превращение в дамку
        if y == 0 and self.board[y][x] == WHITE:
            self.board[y][x] = WHITE_KING
        if y == 7 and self.board[y][x] == BLACK:
            self.board[y][x] = BLACK_KING

    def evaluate_position(self):
        #Оценочный алгоритм - оценка позиции на доске
        white_score = 0
        black_score = 0

        for y in range(8):
            for x in range(8):
                piece = self.board[y][x]
                if piece == WHITE:
                    white_score += 1
                elif piece == BLACK:
                    black_score += 1
                elif piece == WHITE_KING:
                    white_score += 3
                elif piece == BLACK_KING:
                    black_score += 3

        return white_score - black_score

    def check_game_over(self):
        #Алгоритм проверки конца игры
        white_exists = any(self.board[y][x] in (WHITE, WHITE_KING) for y in range(8) for x in range(8))
        black_exists = any(self.board[y][x] in (BLACK, BLACK_KING) for y in range(8) for x in range(8))

        if not white_exists:
            return "black_win"
        if not black_exists:
            return "white_win"

        current = (WHITE, WHITE_KING) if self.turn == WHITE else (BLACK, BLACK_KING)
        has_moves = False
        for y in range(8):
            for x in range(8):
                if self.board[y][x] in current:
                    if self.get_moves(x, y):
                        has_moves = True
                        break
            if has_moves:
                break

        if not has_moves:
            return "blocked"

        white_colors = set()
        black_colors = set()
        for y in range(8):
            for x in range(8):
                if self.board[y][x] in (WHITE, WHITE_KING):
                    white_colors.add((x + y) % 2)
                elif self.board[y][x] in (BLACK, BLACK_KING):
                    black_colors.add((x + y) % 2)
        if white_colors.isdisjoint(black_colors):
            return "draw"

        return None


class GameBoard:

    def __init__(self, root, player_names):
        self.root = root
        self.root.title("Шашки Вигмана")
        self.center_window(WINDOW_WIDTH, WINDOW_HEIGHT)
        self.root.protocol("WM_DELETE_WINDOW", self.on_window_close)

        self.player_names = player_names
        self.engine = GameEngine()
        self.selected = None
        self.possible_moves = []

        self.setup_ui()
        self.update_info()
        self.draw()

    def setup_ui(self):
        #Настройка интерфейса
        top_frame = tk.Frame(self.root, bg="#2c3e50", height=60)
        top_frame.pack(side="top", fill="x")
        top_frame.pack_propagate(False)

        self.turn_label = tk.Label(top_frame, text="", font=("Arial", 18, "bold"),
                                   bg="#2c3e50", fg="white")
        self.turn_label.pack(expand=True)

        self.canvas = tk.Canvas(self.root, width=BOARD_SIZE * CELL_SIZE + 2 * MARGIN,
                                height=BOARD_SIZE * CELL_SIZE + 2 * MARGIN, bg="#34495e")
        self.canvas.pack(pady=5)
        self.canvas.bind("<Button-1>", self.on_click)

        bottom_frame = tk.Frame(self.root)
        bottom_frame.pack(side="bottom", fill="x", pady=5)

        surrender_btn = tk.Button(bottom_frame, text="Сдаться", font=("Arial", 14),
                                  command=self.surrender)
        surrender_btn.pack(side="top", pady=5)

        self.info = tk.StringVar()
        info_label = tk.Label(bottom_frame, textvariable=self.info, font=("Arial", 12))
        info_label.pack(side="top", pady=5)

    def center_window(self, width, height):
        screen_width = self.root.winfo_screenwidth()
        screen_height = self.root.winfo_screenheight()
        x = (screen_width // 2) - (width // 2)
        y = (screen_height // 2) - (height // 2)
        self.root.geometry(f"{width}x{height}+{x}+{y}")

    def update_info(self):
        player_name = self.player_names[0] if self.engine.turn == WHITE else self.player_names[1]
        color = "БЕЛЫЕ" if self.engine.turn == WHITE else "ЧЁРНЫЕ"
        self.turn_label.config(text=f"Ход: {player_name} ({color})")

        if self.engine.must_capture_second:
            self.info.set("⚠ Обязательное взятие! Вы создали угрозу первым полуходом.")
        else:
            half_move_text = f"Полуход {self.engine.half_moves + 1}/2" if self.engine.half_moves > 0 else ""
            self.info.set(half_move_text)

    def draw(self):
        self.canvas.delete("all")

        # Рисуем координаты (буквы A-H сверху и снизу)
        letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H']
        for i, letter in enumerate(letters):
            x = MARGIN + i * CELL_SIZE + CELL_SIZE // 2
            # Сверху
            self.canvas.create_text(x, MARGIN // 2, text=letter,
                                    font=("Arial", 14, "bold"), fill="white")
            # Снизу
            self.canvas.create_text(x, MARGIN + BOARD_SIZE * CELL_SIZE + MARGIN // 2,
                                    text=letter, font=("Arial", 14, "bold"), fill="white")

        # Рисуем координаты (цифры 8-1 слева и справа)
        for i in range(8):
            y = MARGIN + i * CELL_SIZE + CELL_SIZE // 2
            number = str(8 - i)
            # Слева
            self.canvas.create_text(MARGIN // 2, y, text=number,
                                    font=("Arial", 14, "bold"), fill="white")
            # Справа
            self.canvas.create_text(MARGIN + BOARD_SIZE * CELL_SIZE + MARGIN // 2, y,
                                    text=number, font=("Arial", 14, "bold"), fill="white")

        # Рисуем клетки доски
        for y in range(BOARD_SIZE):
            for x in range(BOARD_SIZE):
                color = "#b58863" if (x + y) % 2 == 0 else "#f0d9b5"
                self.canvas.create_rectangle(
                    MARGIN + x * CELL_SIZE, MARGIN + y * CELL_SIZE,
                    MARGIN + (x + 1) * CELL_SIZE, MARGIN + (y + 1) * CELL_SIZE,
                    fill=color
                )

                if (x, y) in self.possible_moves:
                    self.canvas.create_rectangle(
                        MARGIN + x * CELL_SIZE + 4, MARGIN + y * CELL_SIZE + 4,
                        MARGIN + (x + 1) * CELL_SIZE - 4, MARGIN + (y + 1) * CELL_SIZE - 4,
                        outline="green", width=3
                    )

                piece = self.engine.board[y][x]
                if piece != EMPTY:
                    self.draw_piece(x, y, piece)

        if self.selected:
            x, y = self.selected
            self.canvas.create_rectangle(
                MARGIN + x * CELL_SIZE, MARGIN + y * CELL_SIZE,
                MARGIN + (x + 1) * CELL_SIZE, MARGIN + (y + 1) * CELL_SIZE,
                outline="blue", width=3
            )

    def draw_piece(self, x, y, piece):
        cx = MARGIN + x * CELL_SIZE + CELL_SIZE // 2
        cy = MARGIN + y * CELL_SIZE + CELL_SIZE // 2
        r = CELL_SIZE // 2 - 8
        color = "white" if piece in (WHITE, WHITE_KING) else "black"
        self.canvas.create_oval(cx - r, cy - r, cx + r, cy + r, fill=color)
        if piece in (WHITE_KING, BLACK_KING):
            self.canvas.create_text(cx, cy, text="Д", fill="red",
                                    font=("Arial", 18, "bold"))

    def on_click(self, event):
        # Корректируем координаты клика с учетом отступа
        x = (event.x - MARGIN) // CELL_SIZE
        y = (event.y - MARGIN) // CELL_SIZE
        if not (0 <= x < 8 and 0 <= y < 8):
            return

        current = (WHITE, WHITE_KING) if self.engine.turn == WHITE else (BLACK, BLACK_KING)

        if self.selected:
            if (x, y) in self.possible_moves:
                self.engine.make_move(self.selected, (x, y))

                if self.engine.half_moves == 0:
                    self.engine.first_move_pos = (x, y)
                    if self.engine.check_threat_created((x, y)):
                        self.engine.must_capture_second = True
                    else:
                        self.engine.must_capture_second = False
                else:
                    self.engine.must_capture_second = False

                self.engine.half_moves += 1
                self.selected = None
                self.possible_moves = []

                if self.engine.half_moves == 2:
                    self.end_turn()
            else:
                self.selected = None
                self.possible_moves = []

        else:
            if self.engine.board[y][x] in current:
                if self.engine.must_capture_second:
                    if (x, y) != self.engine.first_move_pos:
                        return

                self.selected = (x, y)
                self.possible_moves = self.engine.get_moves(x, y)

        self.update_info()
        self.draw()

    def end_turn(self):
        self.engine.half_moves = 0
        self.engine.turn = BLACK if self.engine.turn == WHITE else WHITE
        self.engine.must_capture_second = False
        self.engine.first_move_pos = None
        self.selected = None
        self.possible_moves = []
        self.update_info()
        self.check_game_over()

    def check_game_over(self):
        result = self.engine.check_game_over()
        if result == "white_win":
            self.finish_game(f"{self.player_names[0]} победил")
        elif result == "black_win":
            self.finish_game(f"{self.player_names[1]} победил")
        elif result == "blocked":
            winner = self.player_names[1] if self.engine.turn == WHITE else self.player_names[0]
            loser = self.player_names[0] if self.engine.turn == WHITE else self.player_names[1]
            self.finish_game(f"{winner} победил - у {loser} нет доступных ходов")
        elif result == "draw":
            self.finish_game("Ничья: фигуры не могут взаимодействовать")

    def surrender(self):
        surrendered = self.player_names[0] if self.engine.turn == WHITE else self.player_names[1]
        winner = self.player_names[1] if self.engine.turn == WHITE else self.player_names[0]
        self.finish_game(f"{surrendered} сдался. Победил {winner}")

    def finish_game(self, message):
        self.canvas.unbind("<Button-1>")
        messagebox.showinfo("Игра окончена", message)
        try:
            self.root.destroy()
        except:
            pass
        show_start_window()

    def on_window_close(self):
        try:
            self.root.destroy()
        except:
            pass
        import sys
        sys.exit(0)


